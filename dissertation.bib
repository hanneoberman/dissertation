  shorttitle = {Moving beyond the Empty Cell},
  author = {Mir, Aya El and family=Sousa, given=Eric Bezerra, prefix=de, useprefix=false and Mesina-Estarr\'on, Ignacio and Celi, Leo Anthony and Hani, Moad and Benjelloun, Mohammed and Nageswaran, Neha and Mahmoudi, Sa\"id and Siddiqui, Shaheen and Sadasivam, Sreeram and Mitchell, William Greig},
  date = {2026},
  journaltitle = {PLOS Digital Health},
