@article{vanbuuren2006,
  title = {Fully Conditional Specification in Multivariate Imputation},
  author = {Van Buuren, S. and Brand, J. P.L. and Groothuis-Oudshoorn, C. G.M. and Rubin, D. B.},
  date = {2006-12-01},
  journaltitle = {Journal of Statistical Computation and Simulation},
  shortjournal = {J. Stat. Comput. Simul.},
  volume = {76},
  number = {12},
  pages = {1049--1064},
  publisher = {Taylor \& Francis},
