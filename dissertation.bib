@article{daniel2012,
  title = {Using Causal Diagrams to Guide Analysis in Missing Data Problems},
  author = {Daniel, Rhian M. and Kenward, Michael G. and Cousens, Simon N. and De Stavola, Bianca L.},
  date = {2012-06},
  journaltitle = {Statistical Methods in Medical Research},
  shortjournal = {Stat. Methods Med. Res.},
