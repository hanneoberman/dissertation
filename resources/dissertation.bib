@article{cai2023,
  title = {Graphical and Numerical Diagnostic Tools to Assess Multiple Imputation Models by Posterior Predictive Checking},
  author = {Cai, Mingyang and family=Buuren, given=Stef, prefix=van, useprefix=true and Vink, Gerko},
  date = {2023-06-01},
